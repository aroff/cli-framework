#!/bin/bash
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}[pre-commit] cargo fmt --check...${NC}"
if ! cargo fmt --all -- --check; then
    echo -e "${RED}[pre-commit] Formatting errors. Run 'cargo fmt --all' to fix.${NC}"
    exit 1
fi
echo -e "${GREEN}[pre-commit] fmt ok${NC}"

# `--workspace` matches the CI step of the same name. Without it cargo selects
# only the root package (`.` is itself a `[workspace] members` entry), so this
# hook silently skipped cli-framework-oidc and cli-framework-macros.
echo -e "${YELLOW}[pre-commit] cargo clippy --workspace --all-features...${NC}"
if ! RUSTFLAGS="-D warnings" cargo clippy --workspace --all-features -- -D warnings; then
    echo -e "${RED}[pre-commit] Clippy errors. Fix them before committing.${NC}"
    exit 1
fi
echo -e "${GREEN}[pre-commit] clippy ok${NC}"
